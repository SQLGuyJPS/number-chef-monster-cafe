{
  "name": "number-chef-monster-cafe",
  "private": true,
  "version": "0.0.1",
  "description": "Number Chef: Monster Café — a math game for a young child",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "cross-env VITE_E2E=1 vite build --outDir dist-e2e",
    "preview": "vite preview",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:content": "tsx scripts/lint-content.ts",
    "content:table": "tsx scripts/content-table.ts",
    "icons": "tsx scripts/make-icons.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run lint:content"
  },
  "dependencies": {
    "@fontsource/andika": "5.3.0",
    "idb": "8.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.2.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1"
  }
}
